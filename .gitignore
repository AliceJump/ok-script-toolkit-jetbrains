# Gradle
.gradle/
build/
.intellijPlatform/
next_error/
# IntelliJ IDEA
.idea/
*.iml
# IDE 编译输出目录（含 .kt 副本与 resources 副本，无 .class）。
# 不加这条的话，RELEASING.md 里的 `git add .` 会把 87 个文件 / 1.1 MB 提交进仓库。
bin/

# Local environment
local.properties
.kotlin/

# 原子写的临时产物（写入中的 .tmp 与旧版备份）
*.ok-script-toolkit.tmp
*.bak

# 协作 agent 的本地工作记录（记忆/日志）。属于开发工具状态，不是项目内容 —— 只在本地留存。
.workbuddy/
