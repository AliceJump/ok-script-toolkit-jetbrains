<idea-plugin>
    <id>com.alicejump.okscripttoolkit</id>
    <name>ok-script Toolkit</name>
    <vendor url="https://github.com/AliceJump/ok-script-toolkit">AliceJump</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>
    <depends>com.intellij.modules.python</depends>
    <depends>com.intellij.modules.json</depends>

    <resource-bundle>messages.OkScriptToolkitBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <projectConfigurable
            parentId="tools"
            instance="com.alicejump.okscripttoolkit.settings.OkScriptToolkitConfigurable"
            id="com.alicejump.okscripttoolkit.settings"
            displayName="ok-script Toolkit"/>

        <completion.contributor
            language="Python"
            implementationClass="com.alicejump.okscripttoolkit.editor.OkPythonCompletionContributor"/>
        <completion.contributor
            language="JSON"
            implementationClass="com.alicejump.okscripttoolkit.editor.OkJsonCompletionContributor"/>

        <documentationProvider implementationClass="com.alicejump.okscripttoolkit.editor.OkDocumentationProvider"/>

        <!-- 角色管理开成编辑器标签页（对齐 VSCode 的 ViewColumn.One 大窗口），
             载体是非物理的 CharacterManagerFile，只由下面的 provider 接管。 -->
        <fileType
            name="ok-script Character Manager"
            implementationClass="com.alicejump.okscripttoolkit.ui.CharacterManagerFileType"
            fieldName="INSTANCE"
            extensions="okcharacters"/>
        <fileEditorProvider implementation="com.alicejump.okscripttoolkit.ui.CharacterManagerEditorProvider"/>

        <codeInsight.declarativeInlayProvider
            language="Python"
            providerId="ok.script.toolkit.python"
            group="OTHER_GROUP"
            bundle="messages.OkScriptToolkitBundle"
            nameKey="hints.python.name"
            descriptionKey="hints.python.description"
            isEnabledByDefault="true"
            implementationClass="com.alicejump.okscripttoolkit.editor.OkInlayHintsProvider"/>
        <codeInsight.declarativeInlayProvider
            language="JSON"
            providerId="ok.script.toolkit.json"
            group="OTHER_GROUP"
            bundle="messages.OkScriptToolkitBundle"
            nameKey="hints.json.name"
            descriptionKey="hints.json.description"
            isEnabledByDefault="true"
            implementationClass="com.alicejump.okscripttoolkit.editor.OkInlayHintsProvider"/>

        <toolWindow
            id="ok-script Templates"
            anchor="right"
            icon="/icons/templates.svg"
            factoryClass="com.alicejump.okscripttoolkit.ui.TemplatesToolWindowFactory"/>
        <toolWindow
            id="ok-script Assets"
            anchor="right"
            icon="/icons/assets.svg"
            factoryClass="com.alicejump.okscripttoolkit.ui.TemplateAssetToolWindowFactory"/>
        <toolWindow
            id="ok-script Temp Shots"
            anchor="right"
            icon="/icons/tempShots.svg"
            factoryClass="com.alicejump.okscripttoolkit.ui.TempScreenshotToolWindowFactory"/>
        <!-- 任务启动器改成左（列表）/ 右（参数）主从分栏，需要纵向空间，所以停靠右侧；
             日志本身不在这里，而是输出到 Run 工具窗口的「ok-script 执行器」标签页。 -->
        <toolWindow
            id="ok-script Tasks"
            anchor="right"
            icon="/icons/task.svg"
            factoryClass="com.alicejump.okscripttoolkit.tasklauncher.TaskLauncherToolWindowFactory"/>

        <notificationGroup
            id="okScriptToolkit"
            displayType="BALLOON"
            isLogByDefault="true"/>
    </extensions>

    <actions>
        <action
            id="com.alicejump.okscripttoolkit.ShowTemplates"
            class="com.alicejump.okscripttoolkit.ui.ShowTemplatesAction"
            text="Show ok-script Templates"
            description="Open the ok-script template gallery">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="control alt T"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt T"/>
        </action>
        <action
            id="com.alicejump.okscripttoolkit.ShowTasks"
            class="com.alicejump.okscripttoolkit.tasklauncher.ShowTasksAction"
            text="Show ok-script Tasks"
            description="Open the ok-script task launcher">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action
            id="com.alicejump.okscripttoolkit.ShowTemplateAssets"
            class="com.alicejump.okscripttoolkit.ui.ShowTemplateAssetsAction"
            text="Show ok-script Template Assets"
            description="Open the ok-script template asset manager">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <!-- 文案在 Action 代码里走 bundle（i18n 铁律），这里只声明 id / class / 默认键位。
             用户可在「设置 → 按键映射」里改键位 —— 键位是个人偏好，不进项目约定文件。 -->
        <action
            id="com.alicejump.okscripttoolkit.ScreenshotToTemplateAssets"
            class="com.alicejump.okscripttoolkit.ui.ScreenshotToTemplateAssetsAction">
            <keyboard-shortcut keymap="$default" first-keystroke="control alt S"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt S"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action
            id="com.alicejump.okscripttoolkit.ShowCharacterManager"
            class="com.alicejump.okscripttoolkit.ui.ShowCharacterManagerAction"
            text="Show ok-script Characters"
            description="Open the ok-script character manager">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action
            id="com.alicejump.okscripttoolkit.ShowTempShots"
            class="com.alicejump.okscripttoolkit.ui.ShowTempShotsAction"
            text="Show ok-script Temp Shots"
            description="Open the ok-script temp screenshot viewer">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <!-- 文案同样走 Action 代码里的 bundle，这里只声明 id / class -->
        <action
            id="com.alicejump.okscripttoolkit.ShowConventionSources"
            class="com.alicejump.okscripttoolkit.ui.ShowConventionSourcesAction">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
